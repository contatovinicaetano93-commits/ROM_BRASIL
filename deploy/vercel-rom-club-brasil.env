# =============================================================================
# VERCEL — Projeto: rom-club-brasil (Production)
# Instância independente — não compartilhar secrets com Iguatemi
# =============================================================================
#
# REQUIRED (verificar valores na Vercel UI — secrets já costumam existir):
# | Var                 | Valor esperado                          | Status tipico        |
# |---------------------|-----------------------------------------|----------------------|
# | ROM_PANEL           | brasil                                  | já set — conferir    |
# | AVEC_UNIT_ID        | 40613                                   | VERIFICAR / setar    |
# | DATABASE_URL        | Supabase pooler (*pooler.supabase.com)  | já set — conferir host|
# | ROM_SESSION_SECRET  | openssl rand -hex 32                    | VERIFICAR (produção) |
# | CRON_SECRET         | openssl rand -hex 32 (≠ Iguatemi)       | já set — conferir    |
# | AVEC_API_TOKEN      | token loja Brasil                       | já set — rotacionar? |
#
# =============================================================================

ROM_PANEL=brasil
NEXT_PUBLIC_ROM_PANEL=brasil
ROM_SEED_PRESET=brasil

# Supabase Postgres pooler (NÃO use Neon ep-long-sun — BR Neon morto)
# Session:  …@aws-*-pooler.supabase.com:5432/postgres?sslmode=require
# Transaction: …@aws-*-pooler.supabase.com:6543/postgres?sslmode=require
# App usa postgres.js com ssl:'require' + prepare:false
# NÃO precisa de DATABASE_URL_UNPOOLED (legado Neon) — pode remover na Vercel UI
DATABASE_URL=

# Avec — unidade Brasil (REQUIRED)
AVEC_UNIT_ID=40613

# HMAC sessões (REQUIRED em produção — independente da senha admin)
ROM_SESSION_SECRET=

# Seeds de login Brasil (admin vê faturamento; funcionário não)
# Definir senhas só na Vercel — nunca commitar valores reais aqui
ROM_ADMIN_USER=ADMIN-BRASIL
ROM_ADMIN_PASSWORD=
ROM_STAFF_USER=FUNC-BRASIL
ROM_STAFF_PASSWORD=

CRON_SECRET=

# Sentry — projeto rom-brasil na org imobi-hl
NEXT_PUBLIC_SENTRY_DSN=

# PostHog — token do projeto rom-brasil (roteado via /ingest no next.config.ts)
# Definir só na Vercel — não commitar valores reais
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

AVEC_API_URL=https://api.avec.beauty
AVEC_API_TOKEN=
AVEC_SYNC_MAX_PAGES=200
AVEC_WEBHOOK_SECRET=

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_API_INSTANCE=rom-brasil
WHATSAPP_WEBHOOK_SECRET=
# Lembrete semanal WhatsApp de despesas (segunda 12:00 UTC) — DDI+DDD
FINANCE_WHATSAPP_NUMBER=
ADMIN_WHATSAPP_NUMBER=

TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_STAFF_CHAT_IDS=

# Relatório diretoria (terça 08:00)
DIRECTOR_REPORT_EMAIL=contato.vinicaetano93@gmail.com
RESEND_API_KEY=

# Split fiscal (CBS/IBS) — conciliação no Financeiro
FISCAL_SPLIT_API_URL=
FISCAL_SPLIT_API_KEY=
FISCAL_SPLIT_ENV=sandbox
FISCAL_SPLIT_TIMEOUT_MS=15000

# Omie — 2 CNPJs desta unidade (Serviços + Comércio)
OMIE_SERVICOS_APP_KEY=
OMIE_SERVICOS_APP_SECRET=
OMIE_COMERCIO_APP_KEY=
OMIE_COMERCIO_APP_SECRET=
